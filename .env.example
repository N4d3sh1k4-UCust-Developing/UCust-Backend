# ─────────────────────────────────────────────────────────────────────────────
# Шаблон .env для стека приложения UCust.
#
# Куда копировать:
#   • сервер:   ~/projects/ucust/.env        (рядом с docker-compose.yml)
#   • локально: <repo>/.env                  (для docker-compose.local.yml)
#
# Копия:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# Файл .env в git не попадает (см. .gitignore).
#
# Значения-заглушки <...> обязательно заменить. Строки, помеченные [CI],
# при деплое через GitHub Actions приходят из secrets и в .env не обязательны —
# нужны только для ручного `docker compose up` без CI.
#
# Полная инвентаризация: docs/env-inventory.md
# ─────────────────────────────────────────────────────────────────────────────

# ── База данных ──────────────────────────────────────────────────────────────
# [CI] Должен совпадать с POSTGRES_PASSWORD в ops/.env
DB_PASSWORD=<пароль ETA_DBUser>

# ── JWT ──────────────────────────────────────────────────────────────────────
# [CI] Одинаковый во всех сервисах, base64, минимум 32 байта энтропии.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET_ACCESS=<base64-секрет>

# ── Дефолтный администратор (создаётся при первом старте пустой БД) ──────────
# [CI]
DEFAULT_ADMIN_EMAIL=superadmin@<домен>
# [CI] Соблюдайте политику пароля: 8–50, Aa + цифра + спецсимвол
DEFAULT_ADMIN_PASSWORD=<пароль админа>

# ── OAuth-провайдеры ─────────────────────────────────────────────────────────
# [CI]
YANDEX_CLIENT_ID=<id>
# [CI]
YANDEX_CLIENT_SECRET=<secret>
# [CI]
VK_CLIENT_ID=<id>
# [CI]
VK_CLIENT_SECRET=<secret>

# ── Геолокация по IP (claim city в JWT) ──────────────────────────────────────
# [CI]
GEO_API_URL=http://ip-api.com/json/{ip}?lang=ru&fields=status,country,city

# ── Почта (notification-service) ─────────────────────────────────────────────
# [CI]
SUPPORT_EMAIL=support@<домен>
# [CI]
FRONTEND_URL=https://<фронт-домен>
# [CI]
MAIL_HOST=smtp.<провайдер>
# [CI]
MAIL_PORT=587
# [CI]
MAIL_USERNAME=<логин SMTP>
# [CI]
MAIL_PASSWORD=<пароль приложения SMTP>
# [CI] false для 587 (STARTTLS), true для 465
MAIL_SSL=false
# [CI]
MAIL_FROM=contact@<домен>
# [CI] Не оставлять пустым: пустое значение попадёт в заголовок From
MAIL_FROM_NAME=UCust

# ── CORS гейта ───────────────────────────────────────────────────────────────
# [CI-V] Через запятую, БЕЗ пробелов. Пусто → дефолт из application-prod.yml
CORS_ALLOWED_ORIGINS=https://<фронт-домен>,https://<админка-домен>

# ── Внутренний контур (S2S) ──────────────────────────────────────────────────
# [CI] Общий X-Internal-Secret: gen-ort ↔ AI-контур и gen-ort → billing quota.
# Должен совпадать с INTERNAL_API_SECRET в .env AI-контура.
# Сгенерировать: openssl rand -base64 32
INTERNAL_API_SECRET=<секрет внутреннего контура>

# [CI] База Единого Шлюза Оркестратора, без пути, напр. http://10.0.0.2:8000
AI_ORCHESTRATOR_ENDPOINT=<http://адрес-AI-шлюза>:8000

# Устарело: в коде не используется (остаток от удалённого AIServiceClient).
# Оставлено только для совместимости со старым compose.
AI_SERVICE_URI=

# ── MinIO: медиа постов (generative-orchestration-service) ───────────────────
MINIO_ENDPOINT=http://minio:9000
# Сейчас используются root-креды MinIO; лучше завести scoped-юзера
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=<пароль root MinIO>
# Публичный URL бакета (через gateway /s3/**), должен быть доступен AI-контуру
MINIO_PUBLIC_BASE_URL=https://<api-домен>/s3/generative-orchestration

# ── MinIO: аватары (user-service) ────────────────────────────────────────────
USER_MINIO_ACCESS_KEY=admin
USER_MINIO_SECRET_KEY=<пароль root MinIO>

# ── MinIO: документы и брендинг (content-service) ────────────────────────────
# [CI]
CONTENT_MINIO_ACCESS_KEY=content-service-user
# [CI]
CONTENT_MINIO_SECRET_KEY=<пароль content-service-user>
# [CI]
CONTENT_MINIO_PUBLIC_BASE_URL=https://<api-домен>/s3/content-service

# ── Gateway: адрес MinIO для публичного роута /s3/** ─────────────────────────
MINIO_S3_URI=http://minio:9000

# ── Квоты ────────────────────────────────────────────────────────────────────
# true → FREE-тариф безлимитный (posts/projects/aiGenerations = -1).
# Для демо/презентации true, для прод-поведения false.
QUOTA_FREE_UNLIMITED=false

# ── Telegram: верификация каналов (generative-orchestration-service) ─────────
# Токен любого бота из @BotFather. Пусто → fallback на парсинг t.me
# (из RU-сети не работает без прокси).
# [CI]
TELEGRAM_BOT_TOKEN=
# HTTP-прокси: host:port | http://host:port | user:pass@host:port, через запятую.
# По умолчанию — локальный xray-контейнер из этого же стека.
# [CI]
TELEGRAM_BOT_PROXY=http://xray:1080

# ── Прочее ───────────────────────────────────────────────────────────────────
# В Java-коде не читается (используется только CI как SSH-хост); легаси
SERVER_TAILSCALE_IP=
